# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
ideas
.agents


# Test / tooling artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
pytest_report.html
tests/outputs/

# Model weights download on first use; never committed
*.pt
.cache/

# Run outputs and selections: regenerated on every run, never committed
outputs/
selections/
deck/
tmp/

# Script logs: teed output from scripts/*.sh, regenerated on every run
logs/

# MkDocs generated content: rebuilt by docs/hooks.py on every build, never committed
site/
docs/index.md
docs/packages/
docs/examples

# Test reports (pytest html + coverage) produced in CI and downloaded into
# docs/ by the pages job, never committed
docs/reports/
